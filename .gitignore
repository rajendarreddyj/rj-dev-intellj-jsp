# =========================================================================
# Gradle
# =========================================================================
.gradle/
**/build/
!**/src/**/build/

# Ignore Gradle GUI config and cache
gradle-app.setting
.gradletasknamecache

# DO NOT ignore the Gradle wrapper family (crucial for portable builds)
!gradle-wrapper.jar
!gradle-wrapper.properties

